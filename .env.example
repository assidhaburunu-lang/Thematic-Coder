# Copy to .env (or set these in your hosting dashboard). All are optional when running locally.

# PostgreSQL connection string. Required on Vercel (added automatically when you connect a Neon database).
# Leave empty on your own computer/server to use the built-in database stored in DATA_DIR.
DATABASE_URL=

# Where the built-in database is kept (only used when DATABASE_URL is empty). Must be on a persistent disk.
DATA_DIR=./data

PORT=3000
# Set to 1 behind a reverse proxy that handles HTTPS (Caddy, Nginx…). Automatic on Vercel.
TRUST_PROXY=0
# How long people stay logged in
SESSION_DAYS=30

# Sign in with Google (optional). Create an OAuth client in Google Cloud Console — see README.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional: only allow Google accounts from these email domains (comma-separated), e.g. school.edu.mv
GOOGLE_ALLOWED_DOMAINS=
# Optional: your site's public address, if Google sign-in builds the wrong return address (e.g. https://thematiccoder.vercel.app)
PUBLIC_URL=
